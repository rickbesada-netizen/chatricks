# ---- Google OAuth (from Google Cloud Console → APIs & Services → Credentials) ----
# Create an "OAuth client ID" of type "Web application".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must EXACTLY match an "Authorized redirect URI" you add in the Cloud Console.
# For local use keep this as-is. If you deploy, use your real https URL.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ---- Token encryption key ----
# 32 random bytes, base64-encoded. Generate one with:  npm run genkey
# If this changes, previously stored client tokens can no longer be decrypted.
TOKEN_ENCRYPTION_KEY=generate-with-npm-run-genkey

# ---- Where the local SQLite database file lives ----
DATABASE_PATH=./data/client-inbox.db

# ---- A simple password to open the dashboard (only you should know it) ----
# This is a basic gate so the app isn't wide open on your machine/host.
APP_PASSWORD=change-me
