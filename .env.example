# ---- Google OAuth (from Google Cloud Console → Clients) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Must EXACTLY match an "Authorized redirect URI" on your OAuth client.
# Cloud (Vercel): use your deployed URL, e.g.
#   https://chatricks.vercel.app/api/auth/callback
GOOGLE_REDIRECT_URI=https://YOUR-APP.vercel.app/api/auth/callback

# ---- Token encryption key ----
# 32 random bytes, base64-encoded. Generate with:  npm run genkey
# If this changes, previously stored client tokens can no longer be decrypted.
TOKEN_ENCRYPTION_KEY=generate-with-npm-run-genkey

# ---- Cloud Postgres (Supabase) ----
# Use the POOLED connection string (Supabase → Project Settings → Database →
# "Connection pooling", port 6543). Include the password.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ---- Dashboard password (only you know it) ----
APP_PASSWORD=change-me
