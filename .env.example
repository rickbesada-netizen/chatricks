# ---- Google OAuth (from Google Cloud Console → Clients) ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OPTIONAL. Leave this UNSET and the app derives its redirect URL automatically
# from the address it's served on (https://<your-domain>/api/auth/callback).
# Only set it to force a specific value. Whatever the app uses must be added as
# an Authorized redirect URI on your Google OAuth client.
# GOOGLE_REDIRECT_URI=https://YOUR-APP.vercel.app/api/auth/callback

# ---- Token encryption key ----
# 32 random bytes, base64-encoded. Generate with:  npm run genkey
# If this changes, previously stored client tokens can no longer be decrypted.
TOKEN_ENCRYPTION_KEY=generate-with-npm-run-genkey

# ---- Cloud Postgres ----
# On Vercel: create a Postgres store and this is injected automatically
# (the app reads DATABASE_URL or POSTGRES_URL). Only set it by hand for a
# database you created elsewhere (e.g. Neon/Supabase pooled connection string).
# DATABASE_URL=postgresql://user:PASSWORD@host:6543/postgres

# ---- Dashboard password (only you know it) ----
APP_PASSWORD=change-me
